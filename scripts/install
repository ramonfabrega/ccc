#!/bin/zsh
# Local install for daily driving: release build → ccc.app (ad-hoc signed,
# stable path so LaunchServices tracks one identity) → ~/Applications, plus
# `ccc` on PATH as a symlink INTO the bundle — one binary, two faces.
#
#   scripts/install          # → ~/Applications/ccc.app + ccc on PATH (ad-hoc, this Mac)
#   scripts/install --dist   # install the last scripts/package cut instead (notarized)
#
# The dev lane. An ad-hoc signature is this Mac's alone; a release for every
# Mac is scripts/package (RELEASES.md), and --dist is how studio runs that
# release build too. A running app is quit and relaunched: this IS the update.
#
# Bundle assembly is `ota bundle` (docs/DESIGN.md §6); everything else here
# — quitting the running app, ~/Applications, the PATH symlink, lsregister,
# the relaunch — is ccc's and stays.
set -e
cd "$(dirname "$0")/.."

command -v ota >/dev/null || { echo "ota is not on PATH — install it from ~/code/fun/ota (scripts/install)"; exit 1; }

if [ "${1:-}" = "--dist" ]; then
  APP_SRC=".build/dist/ccc.app"
  [ -d "$APP_SRC" ] || { echo "no $APP_SRC — run scripts/package first" >&2; exit 1; }
  V=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP_SRC/Contents/Info.plist")
  B=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$APP_SRC/Contents/Info.plist")
  echo "Installing the last cut: v$V build $B"
else
  echo "Building release…"
  swift build -c release 2>&1 | grep -E "error|warning: .*Sources/ccc|Compiling|Build complete" | tail -3
  # No --feed: the dev lane, and that absence is its only definition. No
  # SUFeedURL means the app never constructs Sparkle, never polls the CDN,
  # and `ccc version` says dev.
  ota bundle --name ccc --bundle-id com.ramonfabrega.ccc \
      --display-name "Claude Code Command" \
      --icon Design/AppIcon.icns \
      --out .build/ccc.app
  APP_SRC=".build/ccc.app"
  # Ad-hoc, so LaunchServices and TCC see one stable identity for this Mac.
  codesign --force --sign - "$APP_SRC"
fi
APP_DST="$HOME/Applications/ccc.app"

mkdir -p "$HOME/Applications"
# The APP, not every process called `ccc`. `pgrep -x ccc` was the test until
# 2026-09-06, when this refused to install with "ccc would not quit" while
# the app was already down: `ccc watch`, `ccc attach --headless` and every
# other long-running verb carry the same process name, and one of them
# belonged to a different agent's session. Worse than a false alarm — the
# quit had already succeeded, so the abort left the user with no app and no
# new bundle. Match the bundle's executable path instead; a CLI verb runs
# from the PATH symlink's target too, so the pattern is the full path of the
# app binary AND no argument after it.
app_pids() {
  pgrep -lf "$APP_DST/Contents/MacOS/ccc" 2>/dev/null \
    | awk -v exe="$APP_DST/Contents/MacOS/ccc" '$2 == exe && NF == 2 { print $1 }'
}
WAS_RUNNING=0
if [ -n "$(app_pids)" ]; then
  WAS_RUNNING=1
  echo "quitting the running ccc…"
  osascript -e 'tell application id "com.ramonfabrega.ccc" to quit' 2>/dev/null \
    || { for pid in $(app_pids); do kill "$pid" 2>/dev/null || true; done; }
  for i in $(seq 1 20); do [ -z "$(app_pids)" ] && break; sleep 0.25; done
  [ -n "$(app_pids)" ] && { echo "ccc would not quit (pids: $(app_pids))" >&2; exit 1; }
fi
rm -rf "$APP_DST"
cp -R "$APP_SRC" "$APP_DST"

# CLI: prefer an existing PATH dir we can write. The symlink points into the
# installed bundle so `ccc list` and the app are always the same build — and
# it survives a Sparkle update, which replaces the bundle at the same path.
CLI_SRC="$APP_DST/Contents/MacOS/ccc"
for dir in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
  if [ -d "$dir" ] && [ -w "$dir" ]; then
    ln -sf "$CLI_SRC" "$dir/ccc"
    echo "cli: $dir/ccc → $CLI_SRC"
    break
  fi
done

/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$APP_DST"
echo "installed: $APP_DST"
if [ "$WAS_RUNNING" = "1" ]; then
  open "$APP_DST"
  echo "relaunched"
fi
