#!/bin/zsh
# Cut a self-updating ccc.app for every Mac: build, bundle, Developer-ID
# sign, notarize, staple, zip, appcast, publish, verify the live feed.
#
# Everything after "here is a built binary" is `ota` (RELEASES.md,
# docs/DESIGN.md §6) — the flow this script used to carry by hand, copied
# from disk, which copied it from mux. What stays here is the build, which
# is the only genuinely per-app part.
#
#   scripts/package                 # the real thing: notarized, published, verified
#   scripts/package --no-publish    # everything but the two CDN keys
#   scripts/package --ad-hoc        # packaging test on THIS Mac; refuses to publish
#
# NOTARIZE=0 is gone: it was a variable that had to be remembered, and an
# ad-hoc signature is valid on the building Mac alone. `--ad-hoc` now
# refuses to notarize or publish in code rather than in a comment.
#
# Requirements, all on the Studio: a "Developer ID Application" cert, a
# notarytool keychain profile (ota's default is `mux-notary` — profiles are
# per-Apple-account, not per-app), the fleet's Sparkle EdDSA key in the
# Keychain, and `ota` on PATH (ota's scripts/install).
set -euo pipefail
cd "$(dirname "$0")/.."

command -v ota >/dev/null || { echo "ota is not on PATH — install it from ~/code/fun/ota (scripts/install)"; exit 1; }

echo "Building release…"
swift build -c release 2>&1 | grep -E "error|warning: .*Sources/ccc|Build complete" | tail -3

# The feed keys are what make this a release rather than a dev cut: `ota
# bundle` writes SUFeedURL + SUPublicEDKey only when --feed is given, and
# everything in ccc that asks "which lane is this" reads that absence.
# The EdDSA key here is the PUBLIC half — it is what the app trusts, and
# `ota release` refuses to sign if the Studio's Keychain no longer matches it.
ota bundle --name ccc --bundle-id com.ramonfabrega.ccc \
    --display-name "Claude Code Command" \
    --icon Design/AppIcon.icns \
    --feed ccc --public-key "uxO7dN1BcjeU4YqBP6Anf4LVVoIueNOkRVna1AjpEBQ=" \
    --out .build/dist/ccc.app

ota release .build/dist/ccc.app --feed ccc "$@"

# The GitHub Release, which used to be step 4 of RELEASES.md and therefore a
# sentence rather than a command. That seam is where the flow drifted: 14 of
# the first 16 releases matched the documented `gh release create
# --generate-notes` and two did not, each written by a session that had the
# document open. A release is one act now, so there is nothing left to
# remember — and the notes come from `scripts/release-notes`, one definition
# the normalizing `gh release edit` reads too.
#
# Skipped for the two lanes that are not releases: `--ad-hoc` never leaves
# this Mac, and `--no-publish` deliberately stops before the CDN.
for arg in "$@"; do
    case "$arg" in
        --ad-hoc|--no-publish) echo "skipping the GitHub Release ($arg)"; exit 0 ;;
    esac
done

version="$(cat VERSION)"
tag="v${version}"
zip=".build/dist/ccc-${tag}.zip"

if ! git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    echo "no tag $tag — the zip is published but the Release needs one." >&2
    echo "  git tag -a $tag -m \"ccc $version\" && git push origin $tag && scripts/package" >&2
    exit 1
fi

# Re-runnable: a cut that failed after the upload should not need the
# Release deleted by hand before trying again.
if gh release view "$tag" >/dev/null 2>&1; then
    echo "updating the existing Release $tag"
    gh release edit "$tag" --title "$tag" --notes "$(scripts/release-notes "$tag")"
    gh release upload "$tag" "$zip" --clobber
else
    gh release create "$tag" "$zip" --title "$tag" --notes "$(scripts/release-notes "$tag")"
fi
